# Copy to .env for local `npm run dev`. These values are local placeholders,
# not production secrets. `docker compose up` reads API_FOOTBALL_KEY from the
# shell or from a .env file in this directory and overrides the database URLs
# so the API container talks to the Compose services.

# ──────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ──────────────────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# Host-side URL. Inside Compose this is postgresql://futbol:futbol@postgres:5432/futbol_data
# Integration tests use the futbol_data_test database on the same server.
# ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://futbol:futbol@localhost:5432/futbol_data

# ──────────────────────────────────────────────────────────
# Redis
# Tests use database 1: redis://127.0.0.1:6379/1
# ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────────────
# API-Football (https://www.api-football.com/)
# Get your API key at: https://dashboard.api-football.com/
# The API boots with the placeholder below; sync jobs fail until it is real.
# ──────────────────────────────────────────────────────────
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ──────────────────────────────────────────────────────────
# Rate Limiting (fixed-window limiter used on API key creation)
# The anonymous/API-key sliding window is 50 / key.rateLimit requests per hour.
# ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ──────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────
LOG_LEVEL=info
